{
  "name": "axiom-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser extension that integrates into axiom.trade — portfolio overlay, quick-trade, token enrichment. Logic ported from axiomtrade-rs.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && node tests/smoke.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@wxt-dev/module-svelte": "^2.0.2",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "wxt": "^0.20.0"
  }
}
